# Copie este arquivo para .env e preencha somente no ambiente local.
# O arquivo .env é ignorado pelo Git e nunca deve ser versionado.

ETL_MINIO_ENDPOINT=http://minio:9000
ETL_MINIO_BUCKET=sindusfarma
ETL_MINIO_INPUT_PREFIX=landing
ETL_MINIO_ACCESS_KEY=
ETL_MINIO_SECRET_KEY=

ETL_REQUEST_TIMEOUT_SECONDS=30
ETL_EXTRACTION_BATCH_SIZE=1000
ETL_EXTRACTION_MAX_ATTEMPTS=3
ETL_EXTRACTION_RETRY_INITIAL_DELAY_SECONDS=0.5
ETL_EXTRACTION_RETRY_MAX_DELAY_SECONDS=5

# Opcional: adaptador local usado somente em desenvolvimento e testes.
ETL_SOURCE_DIR=

# Banco de ingestão local. O arquivo é embutido, fica fora do Git e o caminho
# relativo é resolvido a partir do diretório de execução.
ETL_DUCKDB_PATH=data/duckdb/ingestao.duckdb

# Deixe vazio para o runner usar a API interna padrão do Compose.
# Runner/scheduler: http://prefect-server:4200/api.
# Para scripts Python no host com o Compose ativo, exporte no processo:
# PREFECT_API_URL=http://localhost:4200/api.
# Não use localhost no runner: ele aponta para o próprio container.
# Sem API configurada fora do Compose, o health check falha explicitamente.
PREFECT_API_URL=
