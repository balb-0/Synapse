@startuml

!define table(x) class x << (T,#FFAAAA) >>
!define fact(x) class x << (F,#AAFFAA) >>

hide circle
skinparam classAttributeIconSize 0
skinparam nodesep 50
skinparam ranksep 50

table(DIM_TEMPO) {
  + sk_tempo : PK
  + data
  + ano
  + trimestre
  + mes
  + dia
  + dia_semana
  + fim_mes
}

table(DIM_PESQUISA) {
  + sk_pesquisa : PK
  + pesquisa_id : chave durável
  + titulo
}

table(DIM_EMPRESA) {
  + sk_empresa : PK
  + empresa_id : chave durável
  + nome_fantasia
  + part_mercado
  + nacionalidade
  + associado
  + tipo_associado
  + cidade
  + estado
  + pais
}

table(DIM_PESSOA) {
  + sk_pessoa : PK
  + cliente_id : chave de origem
  + empresa_id
  + cargo : restrito
  + departamento : restrito
  + nivel_hierarquico
  + agrupamento_departamento
}

fact(FATO_PARTICIPACAO) {
  + source_checksum : PK composta VARCHAR NOT NULL
  + source_offset : PK composta UBIGINT NOT NULL
  + sk_pesquisa : FK NOT NULL
  + sk_empresa : FK NOT NULL
  + sk_pessoa : FK anulável
  + sk_data_pesquisa : FK anulável
  + sk_data_resposta : FK anulável
  --
  + qtd_participacao : INTEGER NOT NULL = 1
  + seq_ocorrencia : anulável
  + minutos_preenchimento : anulável
  + motivo_minutos_indisponivel : anulável
  + pct_mercado_na_participacao : anulável
}

DIM_TEMPO "0..1" -- "0..n" FATO_PARTICIPACAO : sk_data_pesquisa
DIM_TEMPO "0..1" -- "0..n" FATO_PARTICIPACAO : sk_data_resposta
DIM_PESQUISA "1" -- "0..n" FATO_PARTICIPACAO : sk_pesquisa
DIM_EMPRESA "1" -- "0..n" FATO_PARTICIPACAO : sk_empresa
DIM_PESSOA "0..1" -- "0..n" FATO_PARTICIPACAO : sk_pessoa quando conciliado

note bottom of FATO_PARTICIPACAO
  Uma linha por ocorrência do snapshot selecionado,
  identificada pela PK (source_checksum, source_offset).
  Não há chave natural confirmada para respondentes.
  respondent_id de respostas não identifica cliente_id.
  FKs de pessoa e tempo são anuláveis; pesquisa e empresa
  são obrigatórias e usam a chave desconhecida quando órfãs.
  Minutos nulos exigem motivo_minutos_indisponivel.
end note

@enduml
