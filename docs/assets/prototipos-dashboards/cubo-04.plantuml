@startuml

!define table(x) class x << (T,#FFAAAA) >>
!define fact(x) class x << (F,#AAFFAA) >>

hide circle
skinparam classAttributeIconSize 0
skinparam nodesep 50
skinparam ranksep 50

table(DIM_TEMPO) {
  + sk_tempo : PK
  + data
  + ano
  + trimestre
  + mes
  + dia
  + dia_semana
  + fim_mes
}

table(DIM_PESQUISA) {
  + sk_pesquisa : PK
  + pesquisa_id : chave durável
  + titulo
  + objetivos
}

table(DIM_PERGUNTA) {
  + sk_pergunta : PK
  + pesquisa_id
  + pergunta_id
  + enunciado
  + tipo
  + qtd_alternativas
  + alternativas
  + linhas_matriz
  + colunas_matriz
  + confianca
  + formato_arquivo
  + col_origem
  + observacoes
}

fact(FATO_PESQUISA_PERGUNTA) {
  + sk_pesquisa : FK NOT NULL / PK composta
  + sk_pergunta : FK NOT NULL / PK composta UNIQUE
  + sk_data_pesquisa : FK anulável
}

DIM_TEMPO "0..1" -- "0..n" FATO_PESQUISA_PERGUNTA : sk_data_pesquisa
DIM_PESQUISA "1" -- "0..n" FATO_PESQUISA_PERGUNTA : sk_pesquisa
DIM_PERGUNTA "1" -- "0..1" FATO_PESQUISA_PERGUNTA : sk_pergunta UNIQUE

note bottom of FATO_PESQUISA_PERGUNTA
  Fato sem medidas: uma associação por
  (pesquisa_id de origem, pergunta_id).
  A PK é (sk_pesquisa, sk_pergunta); sk_pergunta é UNIQUE.
  qtd_pergunta é COUNT(*) das associações distintas;
  qtd_alternativas pertence à DIM_PERGUNTA.
  Ano de edição não tem origem homologada.
end note

@enduml
