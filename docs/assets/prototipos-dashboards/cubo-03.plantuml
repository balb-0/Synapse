@startuml

!define table(x) class x << (T,#FFAAAA) >>
!define fact(x) class x << (F,#AAFFAA) >>

hide circle
skinparam classAttributeIconSize 0
skinparam nodesep 50
skinparam ranksep 50

table(DIM_TEMPO) {
  + sk_tempo : PK
  + data
  + ano
  + trimestre
  + mes
  + dia
  + dia_semana
  + fim_mes
}

table(DIM_STATUS_PESQUISA) {
  + sk_status : PK
  + status
  + flag_em_aberto : anulável
  + flag_conta_como_a_finalizar : anulável
  + flag_terminal : anulável
}

table(DIM_AREA) {
  + sk_area : PK
  + area
}

table(DIM_TIPO_PESQUISA) {
  + sk_tipo : PK
  + tipo
}

table(DIM_PERFIL_PESQUISA) {
  + sk_perfil : PK
  + complexidade
  + tipo_resposta
}

fact(FATO_PIPELINE_MENSAL) {
  + sk_data_fim_mes : FK NOT NULL / PK composta
  + data_fim_mes : DATE NOT NULL
  + observed_at : TIMESTAMP NOT NULL
  + sk_status : FK NOT NULL / PK composta
  + sk_area : FK NOT NULL / PK composta
  + sk_tipo : FK NOT NULL / PK composta
  + sk_perfil : FK NOT NULL / PK composta
  --
  + qtd_pesquisas_no_status : BIGINT NOT NULL
  + qtd_entradas_no_mes : BIGINT anulável
  + qtd_saidas_no_mes : BIGINT anulável
}

DIM_TEMPO "1" -- "0..n" FATO_PIPELINE_MENSAL : sk_data_fim_mes
DIM_STATUS_PESQUISA "1" -- "0..n" FATO_PIPELINE_MENSAL : sk_status
DIM_AREA "1" -- "0..n" FATO_PIPELINE_MENSAL : sk_area
DIM_TIPO_PESQUISA "1" -- "0..n" FATO_PIPELINE_MENSAL : sk_tipo
DIM_PERFIL_PESQUISA "1" -- "0..n" FATO_PIPELINE_MENSAL : sk_perfil

note bottom of FATO_PIPELINE_MENSAL
  Estoque: somável entre grupos disjuntos no mesmo mês,
  nunca entre meses. Entradas e saídas ficam indisponíveis
  (NULL) sem histórico de transições; snapshots não as provam.
  A classificação de pesquisas a finalizar é derivada
  na camada semântica, não armazenada no fato.
  Chave primária composta por mês, status, área, tipo e perfil.
end note

@enduml
