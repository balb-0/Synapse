@startuml

!define table(x) class x << (T,#FFAAAA) >>
!define fact(x) class x << (F,#AAFFAA) >>

hide circle
skinparam classAttributeIconSize 0
skinparam nodesep 50
skinparam ranksep 50

table(DIM_PESQUISA) {
  + sk_pesquisa : PK
  + pesquisa_id : chave durável
  + titulo
  + objetivos
}

table(DIM_TEMPO) {
  + sk_tempo : PK
  + data
  + ano
  + trimestre
  + mes
  + dia
  + dia_semana
  + fim_mes
}

table(DIM_AREA) {
  + sk_area : PK
  + area
}

table(DIM_STATUS_PESQUISA) {
  + sk_status : PK
  + status
  + flag_em_aberto : anulável
  + flag_conta_como_a_finalizar : anulável
  + flag_terminal : anulável
}

table(DIM_TIPO_PESQUISA) {
  + sk_tipo : PK
  + tipo
}

table(DIM_PERFIL_PESQUISA) {
  + sk_perfil : PK
  + complexidade
  + tipo_resposta
}

table(DIM_FAMILIA_PESQUISA) {
  + sk_familia : PK
  + titulo_normalizado
  + estado_homologacao
}

table(DIM_FONTE_DADO) {
  + sk_fonte : PK
  + source
}

table(DIM_EXECUCAO_CARGA) {
  + sk_carga : PK
  + source
  + run_id
  + concluded_at
  + source_checksum
}

fact(FATO_CICLO_PESQUISA) {
  + sk_pesquisa : PK / FK
  + sk_data_solicitacao : FK anulável
  + sk_data_aprovacao : FK anulável
  + sk_data_divulgacao : FK anulável
  + sk_data_limite_coleta : FK anulável
  + sk_data_prorrogacao : FK anulável
  + sk_data_entrega : FK anulável
  + sk_area : FK anulável
  + sk_status : FK anulável
  + sk_tipo : FK anulável
  + sk_perfil : FK anulável
  + sk_familia : FK anulável
  + sk_fonte : FK NOT NULL
  + sk_carga : FK NOT NULL
  --
  + dias_corridos_validacao : anulável
  + dias_corridos_coleta : anulável
  + dias_corridos_tabulacao : anulável
  + dias_corridos_ciclo_total : anulável
  + qtd_empresas_na_pesquisa : anulável
  + flag_prorrogada : BOOLEAN NOT NULL
}

DIM_PESQUISA "1" -- "0..1" FATO_CICLO_PESQUISA : sk_pesquisa
DIM_TEMPO "0..1" -- "0..n" FATO_CICLO_PESQUISA : sk_data_solicitacao
DIM_TEMPO "0..1" -- "0..n" FATO_CICLO_PESQUISA : sk_data_aprovacao
DIM_TEMPO "0..1" -- "0..n" FATO_CICLO_PESQUISA : sk_data_divulgacao
DIM_TEMPO "0..1" -- "0..n" FATO_CICLO_PESQUISA : sk_data_limite_coleta
DIM_TEMPO "0..1" -- "0..n" FATO_CICLO_PESQUISA : sk_data_prorrogacao
DIM_TEMPO "0..1" -- "0..n" FATO_CICLO_PESQUISA : sk_data_entrega
DIM_AREA "0..1" -- "0..n" FATO_CICLO_PESQUISA : sk_area
DIM_STATUS_PESQUISA "0..1" -- "0..n" FATO_CICLO_PESQUISA : sk_status
DIM_TIPO_PESQUISA "0..1" -- "0..n" FATO_CICLO_PESQUISA : sk_tipo
DIM_PERFIL_PESQUISA "0..1" -- "0..n" FATO_CICLO_PESQUISA : sk_perfil
DIM_FAMILIA_PESQUISA "0..1" -- "0..n" FATO_CICLO_PESQUISA : sk_familia
DIM_FONTE_DADO "1" -- "0..n" FATO_CICLO_PESQUISA : sk_fonte
DIM_EXECUCAO_CARGA "1" -- "0..n" FATO_CICLO_PESQUISA : sk_carga

note bottom of FATO_CICLO_PESQUISA
  Seis papéis de DIM_TEMPO: solicitação, aprovação,
  divulgação, limite, prorrogação e entrega.
  Durações são dias corridos; NULL quando o par de datas
  está ausente ou inválido. Ano de edição indisponível.
end note

@enduml
