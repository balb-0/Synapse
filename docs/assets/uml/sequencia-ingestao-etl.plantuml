@startuml
!pragma layout smetana

skinparam shadowing false
skinparam sequenceMessageAlign first
skinparam participant {
  BackgroundColor #FFFFFF
  BorderColor #666666
}
skinparam note {
  BackgroundColor #FBFBFB
  BorderColor #AAAAAA
}

actor "Operador de dados" as OPE
participant "Adaptador de eventos\n(watch_landing.py)" as ADAPTER
participant "Flow ingest-object\n(Prefect)" as FLOW
participant "Flow backfill\n(Prefect)" as BACKFILL
participant "Flow complete-warehouse\n(Prefect)" as WAREHOUSE
participant "Tasks load/reconcile/publish_warehouse" as DW_TASKS
collections "Geração Parquet agregada" as PARQUET
participant "MinioObjectReader" as READER
participant "Extrator" as EXTRACTOR
participant "transform_object\n(transform_batch por lote)" as TRANSFORM
participant "DuckDbLoadRepository" as REPO
participant "LoadLogSink" as LOADLOG
database "DuckDB" as DB
participant "Logstash\n(via driver GELF)" as LOGS

group Execução normal
  alt disparo por evento
    ADAPTER -> FLOW : ingest_object(source, bucket, key, version_id, event_id)
  else disparo manual, backfill ou agenda
    OPE -> FLOW : ingest_object(source, bucket, key)
  end
  FLOW -> READER : open(reference)
  READER -> FLOW : fluxo de bytes
  FLOW -> FLOW : SHA-256 do objeto
  FLOW -> REPO : object_already_loaded(checksum)
  REPO -> DB : SELECT em _control_object
  DB --> REPO : nenhuma linha
  REPO --> FLOW : false
  FLOW -> REPO : fetch_compatibility_records(pais), loaded_identities(source) e load(source)
  REPO --> FLOW : referências, identidades e checkpoint
  FLOW -> EXTRACTOR : read(run_id, task_id, checkpoint)
  EXTRACTOR -> READER : open(reference)
  EXTRACTOR --> FLOW : lotes com checkpoint e source_offset absoluto
  EXTRACTOR -->> LOGS : evento JSON de extração por lote
  FLOW -> TRANSFORM : transform_object(lotes, references, previous)
  note right of TRANSFORM
    Identidade decidida uma vez sobre
    todos os lotes do objeto: repetição
    idêntica vira duplicata; versões
    divergentes viram IDENTITY_CONFLICT.
  end note
  TRANSFORM -->> LOGS : evento JSON de transformação por lote
  TRANSFORM --> FLOW : TransformationResult por lote
  loop para cada lote transformado
    FLOW -> REPO : load_batch(result, metadata)
    REPO -> DB : BEGIN TRANSACTION
    REPO -> DB : confere identidades contra _loaded_identity
    REPO -> DB : INSERT aceitos e rejeitados
    REPO -> DB : contagem por run_id e batch_id
    DB --> REPO : carregados e rejeitados
    REPO -> REPO : extraído = carregados + rejeitados + duplicados?
    REPO -> DB : INSERT em _batch_metadata
    REPO -> DB : COMMIT
    REPO -->> LOADLOG : LoadBatchLogEvent
    LOADLOG -->> LOGS : evento JSON de carga
    REPO --> FLOW : LoadResult balanceado
    FLOW -> REPO : commit(checkpoint do lote)
    REPO -> DB : UPSERT em _checkpoint
    note right of FLOW
      O checkpoint só avança depois do
      COMMIT e da reconciliação do lote.
    end note
  end
  FLOW -> FLOW : todas as reconciliações balanced?
  FLOW -> REPO : mark_object_loaded(source, checksum, run_id)
  REPO -> DB : UPSERT em _control_object
  note right of FLOW
    Só é chamado se todos os lotes do
    objeto reconciliaram; caso contrário
    levanta UnbalancedLoadError e o
    objeto não é marcado como concluído.
  end note
  FLOW -->> LOGS : estado final da execução
  FLOW --> OPE : status loaded
end

group Backfill completo com publicação DW
  OPE -> BACKFILL : backfill(six_sources, analytics_output, observed_at opcional)
  BACKFILL -> BACKFILL : validar seis fontes únicas e ordenar dependências
  loop pesquisas, empresas, clientes, questoes, respondentes, respostas
    BACKFILL -> FLOW : ingest_object(reference)
    FLOW --> BACKFILL : loaded ou ignored após confirmação do objeto
  end
  BACKFILL -> WAREHOUSE : complete-warehouse(database, output, observed_at)
  WAREHOUSE -> DW_TASKS : load_warehouse
  DW_TASKS -> DB : abertura com retry e espera limitada por lock
  DW_TASKS -> DB : BEGIN + dimensões + C01-C04 + manifesto + COMMIT
  note right of DW_TASKS
    Sem observed_at real, C03 permanece not_observed.
    Não usar data do scheduler como observação histórica.
    Falha na transação desfaz a carga dimensional.
  end note
  DW_TASKS --> WAREHOUSE : identificação da carga analítica
  WAREHOUSE -> DW_TASKS : reconcile_warehouse
  DW_TASKS -> DB : consultar fatos, fontes e rejeições com motivos
  DW_TASKS --> WAREHOUSE : relatório balanceado ou exceção
  WAREHOUSE -> DW_TASKS : publish_warehouse
  DW_TASKS -> PARQUET : sete arquivos + manifest.json, publicação atômica
  DW_TASKS --> WAREHOUSE : geração publicada
  WAREHOUSE --> BACKFILL : geração e reconciliação
  BACKFILL --> OPE : execução completa concluída
end

group Falha no DW ou publicação
  WAREHOUSE -> DW_TASKS : carregar, reconciliar ou publicar
  DW_TASKS --> WAREHOUSE : falha
  note right of WAREHOUSE
    Até duas repetições somente para falha transitória,
    com timeout por task. Falha permanente ou
    reconciliação inválida não são repetidas.
    Ingestão já confirmada conserva checkpoints.
  end note
  WAREHOUSE --> BACKFILL : exceção propagada
  BACKFILL --> OPE : flow run failed
  OPE -> BACKFILL : reexecutar backfill completo
  BACKFILL -> FLOW : mesmos objetos confirmados
  FLOW --> BACKFILL : ignored
  BACKFILL -> WAREHOUSE : tentar novamente o trecho DW
end

group Falha transitória com retry limitado
  OPE -> FLOW : ingest_object(source, bucket, key)
  FLOW -> EXTRACTOR : read(run_id, checkpoint)
  EXTRACTOR -> READER : open(reference)
  READER --> EXTRACTOR : falha de rede
  EXTRACTOR -> EXTRACTOR : classify_source_failure -> transitória
  loop até max_attempts, com espera progressiva
    EXTRACTOR -> READER : nova tentativa
  end
  alt tentativa bem-sucedida
    EXTRACTOR --> FLOW : ExtractedBatch
  else limite esgotado
    EXTRACTOR --> FLOW : RetryLimitExceededError
    FLOW -> FLOW : _should_retry devolve false
    FLOW -->> LOGS : erro correlacionado e tentativas esgotadas
    FLOW --> OPE : execução falha sem nova tentativa
    note right of FLOW
      Checkpoint e hash não são confirmados.
      A posição anterior permanece válida
      e a próxima execução relê o trecho.
    end note
  end
end

group Falha durante carga ou reconciliação
  FLOW -> REPO : load_batch(result, metadata)
  REPO -> DB : BEGIN + escritas do lote
  DB --> REPO : erro de escrita ou contagem divergente
  REPO -> REPO : UnbalancedLoadError se a reconciliação não fecha
  REPO -> DB : ROLLBACK
  REPO -> DB : INSERT _batch_metadata (falha, contagens zero)
  REPO -->> LOADLOG : evento status=failed
  LOADLOG -->> LOGS : lote falho com run_id e batch_id
  REPO --> FLOW : exceção
  FLOW -> FLOW : _should_retry: UnbalancedLoadError não repete
  FLOW --> OPE : flow run failed
  note right of REPO
    Não há commit do checkpoint.
    O lote será relido desde a última
    posição confirmada.
  end note
end

group Falha permanente
  OPE -> FLOW : ingest_object(source, bucket, key)
  FLOW -> EXTRACTOR : read(run_id, checkpoint)
  EXTRACTOR -> READER : open(reference)
  READER --> EXTRACTOR : credencial inválida ou objeto ausente
  EXTRACTOR -> EXTRACTOR : classify_source_failure -> permanente
  EXTRACTOR --> FLOW : PermanentSourceError
  FLOW -> FLOW : _should_retry devolve false
  FLOW -->> LOGS : falha permanente correlacionada
  FLOW --> OPE : execução falha imediatamente
end

group Reenvio do mesmo conteúdo
  OPE -> FLOW : ingest_object(source, bucket, key)
  FLOW -> READER : open(reference)
  FLOW -> FLOW : SHA-256 do objeto
  FLOW -> REPO : object_already_loaded(checksum)
  REPO -> DB : SELECT em _control_object
  DB --> REPO : linha encontrada
  REPO --> FLOW : true
  FLOW --> OPE : status ignored
  note right of FLOW
    Nenhuma leitura de registro,
    nenhuma escrita e nenhum
    avanço de checkpoint.
  end note
end

@enduml
