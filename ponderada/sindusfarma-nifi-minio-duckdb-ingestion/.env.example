# Credenciais e portas apenas para desenvolvimento local.
# Copie para .env antes de subir o ambiente.

COMPOSE_PROJECT_NAME=sindusfarma-ingestion

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=sindusfarma-data
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

NIFI_HTTP_PORT=8080
HOST_INPUT_DIR=./local/input
NIFI_INPUT_DIR=/opt/nifi/input
NIFI_JVM_HEAP_INIT=512m
NIFI_JVM_HEAP_MAX=1g
NIFI_SENSITIVE_PROPS_KEY=change-this-local-dev-key-32chars
