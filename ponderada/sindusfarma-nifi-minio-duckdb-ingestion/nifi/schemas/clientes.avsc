  "fields": [
    {"name": "id_cliente", "type": ["null", "string"], "default": null},
    {"name": "id_empresa", "type": ["null", "string"], "default": null},
    {"name": "cargo", "type": ["null", "string"], "default": null},
    {"name": "departamento", "type": ["null", "string"], "default": null},
    {"name": "email", "type": ["null", "string"], "default": null}
  ]
}
