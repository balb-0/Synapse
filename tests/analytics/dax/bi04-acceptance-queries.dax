-- Execute these in Power BI Desktop DAX Query View after loading a published
-- generation. They inspect the actual semantic model; Python reference tests
-- do not execute DAX.

-- 0. Run this independent in-engine counterexample. The correct mean is 8.2;
-- averaging the subgroup means would return 5. A zero numerator is numeric 0,
-- while a zero denominator returns BLANK.
DEFINE
    MEASURE 'PUB_C01_CICLO'[BI04 Fixture Media Ponderada] =
        VAR Grupos =
            DATATABLE(
                "Soma", DOUBLE,
                "Base", INTEGER,
                {{1.0, 1}, {81.0, 9}}
            )
        RETURN DIVIDE(SUMX(Grupos, [Soma]), SUMX(Grupos, [Base]))
    MEASURE 'PUB_C01_CICLO'[BI04 Fixture Media Simples] =
        AVERAGEX(DATATABLE("Media", DOUBLE, {{1.0}, {9.0}}), [Media])
    MEASURE 'PUB_C01_CICLO'[BI04 Fixture Zero Numerador] = DIVIDE(0, 4)
    MEASURE 'PUB_C01_CICLO'[BI04 Fixture Base Vazia] = DIVIDE(0, 0)
EVALUATE
ROW(
    "Media Ponderada", [BI04 Fixture Media Ponderada],
    "Media Simples Incorreta", [BI04 Fixture Media Simples],
    "Zero Numerador", [BI04 Fixture Zero Numerador],
    "Denominador Zero", [BI04 Fixture Base Vazia]
)

-- 1. Overall values in the current model filter context. Confirm each mean's
-- valid base and inspect C03 availability separately from its numeric value.
EVALUATE
ROW(
    "Media Dias Validacao", [Media Dias Validacao],
    "Base Valida Validacao", [Base Valida Validacao],
    "Media Minutos Preenchimento", [Media Minutos Preenchimento],
    "Base Valida Preenchimento", [Base Valida Preenchimento],
    "Data de Referencia do Estoque", [Data de Referência do Estoque],
    "Estoque", [Estoque no Último Mês Observado],
    "Estado do Estoque", [Estado do Estoque],
    "Entradas", [Entradas no Mês],
    "Estado das Entradas", [Estado das Entradas no Mês],
    "Saidas", [Saídas no Mês],
    "Estado das Saidas", [Estado das Saídas no Mês]
)

-- 2. Replace the two values with observed months from the loaded generation.
-- The measure must use the last observed month in this selected range and sum
-- all disjoint groups in that one month, never the stock from both months.
EVALUATE
CALCULATETABLE(
    ROW(
        "Data de Referencia", [Data de Referência do Estoque],
        "Estoque", [Estoque no Último Mês Observado],
        "Estado", [Estado do Estoque]
    ),
    TREATAS({"2026-09", "2026-10"}, DIM_TEMPO[ano_mes])
)

-- 3. Use the real C03 report hierarchy. Replace the months and <area> with an
-- area that has rows in an earlier selected close but none in the latest one.
-- The dimension slicer must not move the reference date back to September;
-- October is evidenced globally by area B, so area A's stock is zero there.
EVALUATE
CALCULATETABLE(
    SUMMARIZECOLUMNS(
        PUB_C03_PIPELINE_MENSAL[area],
        PUB_C03_PIPELINE_MENSAL[tipo],
        PUB_C03_PIPELINE_MENSAL[perfil],
        "Data de Referencia", [Data de Referência do Estoque],
        "Estoque", [Estoque no Último Mês Observado],
        "Estado", [Estado do Estoque]
    ),
    TREATAS({"2026-09", "2026-10"}, DIM_TEMPO[ano_mes]),
    TREATAS({"<area>"}, DIM_AREA[area])
)

-- 4. Use a month present in DIM_TEMPO but without any C03 row. The numeric
-- stock must be BLANK and the companion status must explain the missing row.
EVALUATE
CALCULATETABLE(
    ROW(
        "Data de Referencia", [Data de Referência do Estoque],
        "Estoque", [Estoque no Último Mês Observado],
        "Estado", [Estado do Estoque]
    ),
    TREATAS({"2099-12"}, DIM_TEMPO[ano_mes])
)

-- 5. The current contract publishes no transition history. Both numeric flow
-- measures must stay BLANK; the status measures must provide the reason.
EVALUATE
ROW(
    "Entradas", [Entradas no Mês],
    "Estado das Entradas", [Estado das Entradas no Mês],
    "Saidas", [Saídas no Mês],
    "Estado das Saidas", [Estado das Saídas no Mês]
)
