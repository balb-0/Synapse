/// C02 — Participação e Representatividade. Snapshot derivado de bi.vw_participacao.
table D02_Participacao
	lineageTag: d82d5d8c-07ea-4744-ba85-e5340acedfef

	/// Volume de participações observadas. Não representa adesão, market share ou desempenho.
	measure 'Participações Observadas' = SUM('D02_Participacao'[qtd_participacao])
		formatString: #,0
		displayFolder: 10. Benchmark externo
		lineageTag: a871b1b2-b635-4e6e-84bb-dea5adaa403a

	/// Pesquisas distintas com participação observada no recorte.
	measure 'Pesquisas com Participação' = DISTINCTCOUNT('D02_Participacao'[pesquisa_id_origem])
		formatString: #,0
		displayFolder: 10. Benchmark externo
		lineageTag: bafc13e1-e13e-487a-a484-4c6154303fec

	/// Quantidade de empresas no conjunto comparável, preservando os demais filtros do recorte.
	measure 'Empresas no Benchmark' = CALCULATE(DISTINCTCOUNT('D02_Participacao'[empresa_id_duravel]), REMOVEFILTERS('D02_Participacao'[empresa_id_duravel], 'D02_Participacao'[empresa]))
		formatString: #,0
		displayFolder: 10. Benchmark externo
		lineageTag: 0981ba6a-2c0a-4da1-8b56-7897f4612d40

	/// Média de participações observadas por empresa no conjunto comparável, preservando filtros de pesquisa/cargo/departamento/período e removendo apenas a seleção da empresa.
	measure 'Média de Participações do Benchmark' =
			VAR EmpresasComparaveis =
			    CALCULATETABLE (
			        VALUES ( 'D02_Participacao'[empresa_id_duravel] ),
			        REMOVEFILTERS ( 'D02_Participacao'[empresa_id_duravel], 'D02_Participacao'[empresa] )
			    )
			RETURN
			    AVERAGEX (
			        EmpresasComparaveis,
			        CALCULATE (
			            [Participações Observadas],
			            REMOVEFILTERS ( 'D02_Participacao'[empresa] )
			        )
			    )
		formatString: #,0.0
		displayFolder: 10. Benchmark externo
		lineageTag: a11ad3d1-3e06-4d1a-b5f3-39038566465b

	/// Diferença percentual de participações observadas da empresa selecionada em relação à média comparável.
	measure 'Diferença vs Média do Benchmark' = DIVIDE([Participações Observadas] - [Média de Participações do Benchmark], [Média de Participações do Benchmark])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 10. Benchmark externo
		lineageTag: 6eb6f55b-2b87-4862-9a9a-708257a953d6

	/// Posição da empresa selecionada pelo volume de participações observadas dentro do conjunto comparável; 1 é o maior volume. Não mede qualidade, adesão ou desempenho.
	measure 'Posição por Participações' =
			IF (
			    HASONEVALUE ( 'D02_Participacao'[empresa_id_duravel] ),
			    RANKX (
			        CALCULATETABLE (
			            VALUES ( 'D02_Participacao'[empresa_id_duravel] ),
			            REMOVEFILTERS ( 'D02_Participacao'[empresa_id_duravel], 'D02_Participacao'[empresa] )
			        ),
			        CALCULATE (
			            [Participações Observadas],
			            REMOVEFILTERS ( 'D02_Participacao'[empresa] )
			        ),
			        ,
			        DESC,
			        DENSE
			    )
			)
		formatString: #,0
		displayFolder: 10. Benchmark externo
		lineageTag: 399df75f-45f7-4f80-9b24-f4c579a37019

	/// Percentil da empresa pelo volume de participações observadas no conjunto comparável.
	measure 'Percentil de Participação' = VAR Posicao = [Posição por Participações] VAR TotalEmpresas = [Empresas no Benchmark] RETURN IF(NOT ISBLANK(Posicao) && TotalEmpresas > 1, 1 - DIVIDE(Posicao - 1, TotalEmpresas - 1))
		formatString: 0.0%
		displayFolder: 10. Benchmark externo
		lineageTag: 1304221c-719e-4979-8ac8-fb6d0ba53c2d

	/// Faixa de quartil pelo volume de participações observadas; não mede qualidade ou adesão.
	measure 'Quartil de Participação' = VAR Percentil = [Percentil de Participação] RETURN SWITCH(TRUE(), ISBLANK(Percentil), BLANK(), Percentil >= 0.75, "Quartil superior", Percentil >= 0.50, "Segundo quartil", Percentil >= 0.25, "Terceiro quartil", "Quarto quartil")
		displayFolder: 10. Benchmark externo
		lineageTag: 554b615d-6758-4d5a-bd71-a30ceaef6de0

	column sk_participacao
