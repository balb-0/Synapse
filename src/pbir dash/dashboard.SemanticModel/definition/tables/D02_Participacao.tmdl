	partition D02_Participacao = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents("C:\\Users\\Inteli\\Documents\\projetos_inteli\\g05\\data\\powerbi_gold_simulada\\vw_participacao.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"sk_participacao", Int64.Type}, {"data_pesquisa", type date}, {"data_resposta", type date}, {"qtd_participacao", Int64.Type}, {"seq_ocorrencia", Int64.Type}, {"minutos_preenchimento", Int64.Type}, {"pct_mercado_na_participacao", type number}})
				in
				    Tipos

