/// C01 — Portfólio e Ciclo. Snapshot derivado de bi.vw_ciclo_pesquisa.
table D01_CicloPesquisa
	lineageTag: 188b461d-479c-4ff1-b59f-8becb3919142

	/// Contagem distinta de pesquisas no recorte atual.
	measure Pesquisas = DISTINCTCOUNT('D01_CicloPesquisa'[pesquisa_id_origem])
		formatString: #,0
		displayFolder: 01. Operação
		lineageTag: 5ce5e560-779a-49a7-80e9-61b9debe51d7

	/// Pesquisas finalizadas no recorte atual.
	measure 'Pesquisas Finalizadas' = CALCULATE([Pesquisas], KEEPFILTERS('D01_CicloPesquisa'[status] = "Finalizada"))
		formatString: #,0
		displayFolder: 01. Operação
		lineageTag: c14d8be9-3bc9-41ea-9e28-e61dd1133f5b

	/// Pesquisas com status Em andamento no recorte atual.
	measure 'Pesquisas em Andamento' = CALCULATE([Pesquisas], KEEPFILTERS('D01_CicloPesquisa'[status] = "Em andamento"))
		formatString: #,0
		displayFolder: 01. Operação
		lineageTag: 1b3a91fc-1269-4a08-b4ae-6c2e3edfa282

	/// Proporção de pesquisas finalizadas no conjunto filtrado.
	measure 'Taxa de Finalização' = DIVIDE([Pesquisas Finalizadas], [Pesquisas])
		formatString: 0.0%
		displayFolder: 01. Operação
		lineageTag: c7093831-5dbd-4b0f-a5d1-c0152ac6f2ac

	/// Proporção de pesquisas prorrogadas no conjunto filtrado.
	measure 'Taxa de Prorrogação' = DIVIDE(CALCULATE([Pesquisas], KEEPFILTERS('D01_CicloPesquisa'[flag_prorrogada] = TRUE())), [Pesquisas])
		formatString: 0.0%
		displayFolder: 01. Operação
		lineageTag: 5e453da0-7ca2-4320-a811-291f66d7dca9

	/// Média dos ciclos concluídos com duração disponível; medida em dias corridos, não úteis.
	measure 'Ciclo Médio em Dias Corridos' = AVERAGE('D01_CicloPesquisa'[dias_ciclo_total_corridos])
		formatString: 0.0
		displayFolder: 01. Operação
		lineageTag: fb174f94-42b7-415c-882e-0b20b3ec24ee

	/// Média de dias corridos entre solicitação e aprovação no recorte atual.
	measure 'Ciclo Médio Validação em Dias Corridos' = AVERAGE ( D01_CicloPesquisa[dias_validacao_corridos] )
		displayFolder: 01. Operação
		lineageTag: bc780d30-8c1f-4755-8234-183036eb4661

	/// Média de dias corridos da etapa de coleta no recorte atual.
	measure 'Ciclo Médio Coleta em Dias Corridos' = AVERAGE ( D01_CicloPesquisa[dias_coleta_corridos] )
		displayFolder: 01. Operação
		lineageTag: 540e1c1e-61b9-4919-af4b-3105ba6b73d7

	/// Média de dias corridos da etapa de tabulação no recorte atual.
	measure 'Ciclo Médio Tabulação em Dias Corridos' = AVERAGE ( D01_CicloPesquisa[dias_tabulacao_corridos] )
		displayFolder: 01. Operação
		lineageTag: 977ee54e-4c37-4287-b479-f8995e6917ac

	/// Média de empresas participantes por pesquisa no recorte atual.
	measure 'Empresas Médias por Pesquisa' = AVERAGE ( D01_CicloPesquisa[qtd_empresas_na_pesquisa] )
		displayFolder: 01. Operação
		lineageTag: b19e75a9-86fb-42ac-a025-5c62cd7e1cd8

	/// Pesquisas marcadas como prorrogadas no recorte atual.
	measure 'Pesquisas Prorrogadas' = CALCULATE ( [Pesquisas], KEEPFILTERS ( D01_CicloPesquisa[flag_prorrogada] = TRUE () ) )
		displayFolder: 01. Operação
		lineageTag: c6a1def5-55f9-45ae-85a0-79f246263c06

	/// Pesquisas não finalizadas no recorte atual, cobrindo os status disponíveis no cubo.
	measure 'Pesquisas em Aberto' = CALCULATE ( [Pesquisas], KEEPFILTERS ( 'D01_CicloPesquisa'[status] IN { "Em andamento", "Em tabulação", "Planejada" } ) )
		formatString: #,0
		displayFolder: 01. Operação
		lineageTag: c912a364-6449-4b24-9acd-61440c7159d7

