table DIM_STATUS_PESQUISA
	lineageTag: f9bf89cf-2c8b-43b0-8f5d-fb9aafe9367e

	column status
		lineageTag: 15255fd8-07ce-43c8-892f-2b4a3e36e8a7
		summarizeBy: none
		isNameInferred
		sourceColumn: [status]

	partition DIM_STATUS_PESQUISA = calculated
		mode: import
		source =
				SELECTCOLUMNS(
					DISTINCT(
						UNION(
							ALLNOBLANKROW(PUB_C01_CICLO[status]),
							ALLNOBLANKROW(PUB_C03_PIPELINE_MENSAL[status])
						)
					),
					"status", [status]
				)

