table DIM_AREA
	lineageTag: 9cd20d42-4f5e-4b6e-afe0-f5acf032f702

	column area
		lineageTag: 9a8ee4f0-58e1-4693-a8b0-618494448fae
		summarizeBy: none
		isNameInferred
		sourceColumn: [area]

	partition DIM_AREA = calculated
		mode: import
		source =
				SELECTCOLUMNS(
					DISTINCT(
						UNION(
							ALLNOBLANKROW(PUB_C01_CICLO[area]),
							ALLNOBLANKROW(PUB_C02_PARTICIPACAO[area]),
							ALLNOBLANKROW(PUB_C03_PIPELINE_MENSAL[area]),
							ALLNOBLANKROW(PUB_C04_INSTRUMENTO[area])
						)
					),
					"area", [area]
				)

