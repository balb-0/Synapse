table PUB_C04_INSTRUMENTO

	measure 'Qtd Perguntas' = SUM(PUB_C04_INSTRUMENTO[qtd_perguntas])
		formatString: #,0

	column area
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: area

	column tipo_pergunta
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: tipo_pergunta

	column qtd_perguntas
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: qtd_perguntas

	partition PUB_C04_INSTRUMENTO = m
		mode: import
		source =
				let
					Origem = Parquet.Document(File.Contents(PastaPublicacaoBI & "\PUB_C04_INSTRUMENTO.parquet"))
				in
					Origem
