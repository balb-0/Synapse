table PUB_QUALIDADE_RELACAO
	lineageTag: 92d81c90-9e2f-4a71-b6c5-257eb25058ed

	measure 'Integridade Referencial' = DIVIDE(SUM(PUB_QUALIDADE_RELACAO[qtd_chaves_correspondentes]), SUM(PUB_QUALIDADE_RELACAO[qtd_chaves_informadas]))
		formatString: 0.0%
		lineageTag: 29c29a02-62e3-42bd-8c0b-7f5f6f927bc1

	measure 'Base Valida Integridade' = SUM(PUB_QUALIDADE_RELACAO[qtd_chaves_informadas])
		formatString: #,0
		lineageTag: eed78c35-4228-44e9-8476-64590280999e

	column relacao
		dataType: string
		lineageTag: ec310ae4-7cfe-46fd-ac8d-4b3e1fd523f0
		summarizeBy: none
		sourceColumn: relacao

	column qtd_chaves_informadas
