table PUB_C02_PARTICIPACAO

	column area
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: area

	column tipo
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: tipo

	column mes_resposta
		dataType: dateTime
		isHidden
		summarizeBy: none
		formatString: Short Date
		sourceColumn: mes_resposta

	column qtd_participacoes
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: qtd_participacoes

	column soma_minutos_preenchimento
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: soma_minutos_preenchimento

	column qtd_preenchimento_disponivel
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: qtd_preenchimento_disponivel

	partition PUB_C02_PARTICIPACAO = m
		mode: import
		source =
				let
					Origem = Parquet.Document(File.Contents(PastaPublicacaoBI & "\PUB_C02_PARTICIPACAO.parquet"))
				in
					Origem
