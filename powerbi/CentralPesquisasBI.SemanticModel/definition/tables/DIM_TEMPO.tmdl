table DIM_TEMPO
	lineageTag: 9143db66-c9e5-4f35-b6d0-2ccd89fb03e2

	column data
		isHidden
		formatString: Short Date
		lineageTag: e014255d-3845-4417-a1d0-2093a3746be8
		summarizeBy: none
		isNameInferred
		sourceColumn: [data]

	column ano
		lineageTag: 82107bc2-c128-4ff9-b263-f6e88439f33d
		summarizeBy: none
		isNameInferred
		sourceColumn: [ano]

	column numero_trimestre
		isHidden
		lineageTag: 418c494f-7622-4aa8-8df7-11fc9d62c9b5
		summarizeBy: none
		isNameInferred
		sourceColumn: [numero_trimestre]

	column trimestre
		lineageTag: a6738636-7fa1-49e3-aa4c-e5797cdadd4e
		summarizeBy: none
		isNameInferred
		sourceColumn: [trimestre]
		sortByColumn: numero_trimestre

	column numero_mes
		isHidden
		lineageTag: d72a6c3f-2816-4bbc-93f2-19f91be5109e
		summarizeBy: none
		isNameInferred
		sourceColumn: [numero_mes]

	column mes
		lineageTag: fbaf5320-1b84-4ba8-abef-8e200717a67a
		summarizeBy: none
		isNameInferred
		sourceColumn: [mes]
		sortByColumn: numero_mes

	column ano_mes
		lineageTag: e3bdb9c1-6de3-4d31-863d-1ad560155ff2
		summarizeBy: none
		isNameInferred
		sourceColumn: [ano_mes]
		sortByColumn: ano_mes_ordenacao

	column ano_mes_ordenacao = IF(ISBLANK([data]), BLANK(), YEAR([data]) * 100 + MONTH([data]))
		dataType: int64
		isHidden
		lineageTag: a446ee08-6f01-47e7-b1b6-8ee03243b937
		summarizeBy: none

	hierarchy Calendario
		lineageTag: calendario-hierarchy

		level Ano
			lineageTag: 9b11c071-bed9-4903-b992-fc51e26a1bdd
			column: ano

		level Trimestre
			lineageTag: 0d782c2d-428b-4ca9-823f-96f23c6eb6dd
			column: trimestre

		level Mes
			lineageTag: 88428145-e055-4205-b4db-ca223bb117fc
			column: mes

	partition DIM_TEMPO = calculated
		mode: import
		source =
				VAR _DatasParticipacao = SELECTCOLUMNS(PUB_C02_PARTICIPACAO, "data", [mes_resposta])
				VAR _DatasPipeline = SELECTCOLUMNS(PUB_C03_PIPELINE_MENSAL, "data", [data_fim_mes])
				VAR _Datas =
					FILTER(
						DISTINCT(UNION(_DatasParticipacao, _DatasPipeline)),
						NOT ISBLANK([data])
					)
				VAR _ComColunas =
					ADDCOLUMNS(
						_Datas,
						"ano", IF(ISBLANK([data]), BLANK(), YEAR([data])),
						"numero_trimestre", IF(ISBLANK([data]), BLANK(), QUARTER([data])),
						"trimestre", IF(ISBLANK([data]), BLANK(), "T" & QUARTER([data])),
						"numero_mes", IF(ISBLANK([data]), BLANK(), MONTH([data])),
						"mes", IF(ISBLANK([data]), BLANK(), FORMAT([data], "MMM")),
						"ano_mes", IF(ISBLANK([data]), BLANK(), FORMAT([data], "YYYY-MM"))
					)
				RETURN
					_ComColunas

