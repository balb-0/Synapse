table DIM_TEMPO

	column data
		dataType: dateTime
		isHidden
		summarizeBy: none
		formatString: Short Date
		isNameInferred
		isDataTypeInferred
		sourceColumn: [data]

	column ano
		dataType: int64
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [ano]

	column numero_trimestre
		dataType: int64
		isHidden
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [numero_trimestre]

	column trimestre
		dataType: string
		summarizeBy: none
		sortByColumn: numero_trimestre
		isNameInferred
		isDataTypeInferred
		sourceColumn: [trimestre]

	column numero_mes
		dataType: int64
		isHidden
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [numero_mes]

	column mes
		dataType: string
		summarizeBy: none
		sortByColumn: numero_mes
		isNameInferred
		isDataTypeInferred
		sourceColumn: [mes]

	column ano_mes
		dataType: string
		summarizeBy: none
		sortByColumn: ano_mes_ordenacao
		isNameInferred
		isDataTypeInferred
		sourceColumn: [ano_mes]

	column ano_mes_ordenacao = IF(ISBLANK([data]), BLANK(), YEAR([data]) * 100 + MONTH([data]))
		dataType: int64
		isHidden
		summarizeBy: none

	hierarchy Calendario
		lineageTag: calendario-hierarchy

		level Ano
			column: ano

		level Trimestre
			column: trimestre

		level 'Mes'
			column: mes

	partition DIM_TEMPO = calculated
		mode: import
		source = ```
				VAR _DatasParticipacao = SELECTCOLUMNS(PUB_C02_PARTICIPACAO, "data", [mes_resposta])
				VAR _DatasPipeline = SELECTCOLUMNS(PUB_C03_PIPELINE_MENSAL, "data", [data_fim_mes])
				VAR _Datas =
					FILTER(
						DISTINCT(UNION(_DatasParticipacao, _DatasPipeline)),
						NOT ISBLANK([data])
					)
				VAR _ComColunas =
					ADDCOLUMNS(
						_Datas,
						"ano", IF(ISBLANK([data]), BLANK(), YEAR([data])),
						"numero_trimestre", IF(ISBLANK([data]), BLANK(), QUARTER([data])),
						"trimestre", IF(ISBLANK([data]), BLANK(), "T" & QUARTER([data])),
						"numero_mes", IF(ISBLANK([data]), BLANK(), MONTH([data])),
						"mes", IF(ISBLANK([data]), BLANK(), FORMAT([data], "MMM")),
						"ano_mes", IF(ISBLANK([data]), BLANK(), FORMAT([data], "YYYY-MM"))
					)
				RETURN
					_ComColunas
				```
