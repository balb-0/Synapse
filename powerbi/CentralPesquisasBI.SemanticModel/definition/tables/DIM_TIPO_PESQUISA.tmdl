table DIM_TIPO_PESQUISA
	lineageTag: 9253e55c-c9ba-489c-9049-65f551443c4d

	column tipo
		lineageTag: 4a21433b-ba64-4927-acd7-b985b0be99ab
		summarizeBy: none
		isNameInferred
		sourceColumn: [tipo]

	partition DIM_TIPO_PESQUISA = calculated
		mode: import
		source =
				SELECTCOLUMNS(
					DISTINCT(
						UNION(
							ALLNOBLANKROW(PUB_C01_CICLO[tipo]),
							ALLNOBLANKROW(PUB_C02_PARTICIPACAO[tipo]),
							ALLNOBLANKROW(PUB_C03_PIPELINE_MENSAL[tipo])
						)
					),
					"tipo", [tipo]
				)

